<Window x:Class="TrayWebApps.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit Widget" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown">
  <Border x:Name="WidgetBorder" CornerRadius="10" Background="#26372F" BorderBrush="#3A4A40" BorderThickness="1">
    <TextBlock x:Name="WidgetLabel" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" />
  </Border>
</Window>
