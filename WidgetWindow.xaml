<Window x:Class="TrayWebApps.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit Widget" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" Icon="Assets/AppIcon.ico"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown">
  <Border x:Name="WidgetBorder" CornerRadius="10" Background="#26372F" BorderBrush="#3A4A40" BorderThickness="1" ClipToBounds="True">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
      <Image x:Name="WidgetImage" Stretch="Uniform" MaxHeight="64" HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed" />
      <TextBlock x:Name="WidgetLabel" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="14"
                 HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
