<Window x:Class="TrayWebApps.SetPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit PIN" Width="320" Height="500" MinWidth="320" MinHeight="500"
        WindowStyle="None" ResizeMode="NoResize" Background="#0B0F15" Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" Topmost="True"
        KeyDown="Window_KeyDown">
  <Border BorderBrush="#323C4E" BorderThickness="1" Background="#0B0F15">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Set app PIN" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock x:Name="SubtitleText" Grid.Row="1" Text="Enter a new PIN for this app." Foreground="{DynamicResource MutedInk}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />
      <TextBlock x:Name="PinDisplay" Grid.Row="2" Text="" Foreground="{DynamicResource Ink}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Height="40" Margin="0,4,0,4" />

      <Grid Grid.Row="3" x:Name="Keypad" Margin="0,4,0,10">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Content="1" FontSize="20" Click="Digit_Click" Tag="1" Margin="4" Background="#171D27" />
        <Button Grid.Row="0" Grid.Column="1" Content="2" FontSize="20" Click="Digit_Click" Tag="2" Margin="4" Background="#171D27" />
        <Button Grid.Row="0" Grid.Column="2" Content="3" FontSize="20" Click="Digit_Click" Tag="3" Margin="4" Background="#171D27" />
        <Button Grid.Row="1" Grid.Column="0" Content="4" FontSize="20" Click="Digit_Click" Tag="4" Margin="4" Background="#171D27" />
        <Button Grid.Row="1" Grid.Column="1" Content="5" FontSize="20" Click="Digit_Click" Tag="5" Margin="4" Background="#171D27" />
        <Button Grid.Row="1" Grid.Column="2" Content="6" FontSize="20" Click="Digit_Click" Tag="6" Margin="4" Background="#171D27" />
        <Button Grid.Row="2" Grid.Column="0" Content="7" FontSize="20" Click="Digit_Click" Tag="7" Margin="4" Background="#171D27" />
        <Button Grid.Row="2" Grid.Column="1" Content="8" FontSize="20" Click="Digit_Click" Tag="8" Margin="4" Background="#171D27" />
        <Button Grid.Row="2" Grid.Column="2" Content="9" FontSize="20" Click="Digit_Click" Tag="9" Margin="4" Background="#171D27" />
        <Button Grid.Row="3" Grid.Column="0" Content="Clear" FontSize="13" Click="ClearDigits_Click" Margin="4" Background="#171D27" />
        <Button Grid.Row="3" Grid.Column="1" Content="0" FontSize="20" Click="Digit_Click" Tag="0" Margin="4" Background="#171D27" />
        <Button Grid.Row="3" Grid.Column="2" Content="⌫" FontSize="18" Click="Backspace_Click" Margin="4" Background="#171D27" />
      </Grid>

      <Button Grid.Row="4" Content="Remove PIN" Click="RemovePin_Click" HorizontalAlignment="Left" Foreground="#FF8D98" Margin="0,0,0,6" />

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
        <Button Content="Save" Click="Save_Click" Background="#24483D" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
